# Solo configuracion publica. Nunca colocar service_role ni claves de IA aqui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
# Captura de errores (Sentry). El DSN es público por diseño: solo permite enviar eventos.
# Vacío desactiva el envío.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
