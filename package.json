    "test:integration": "node --env-file=.env.local scripts/integration.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "supabase": "2.118.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  }
}
