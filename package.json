{
  "name": "camino-a-la-gloria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/.env.local",
    "test:integration": "node scripts/integration.mjs",
    "test:game-integration": "node --experimental-transform-types scripts/game-integration.mjs",
    "test:narrative-db": "node scripts/narrative-db-integration.mjs",
    "test:narrative-http": "node --experimental-transform-types scripts/narrative-http-integration.mjs",
    "test:narrative-live": "node --env-file=supabase/.env.local --experimental-transform-types scripts/narrative-http-integration.mjs --live",
    "report:narrative-usage": "node scripts/narrative-usage.mjs",
    "test:cloud": "node scripts/cloud-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "pg": "8.23.1",
    "supabase": "2.118.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  }
}
