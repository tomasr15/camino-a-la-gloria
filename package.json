{
  "name": "camino-a-la-gloria",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
