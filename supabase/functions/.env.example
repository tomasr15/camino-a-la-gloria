ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SUPABASE_URL and SUPABASE_ANON_KEY are injected by the Supabase runtime.
# No service_role key is used by these functions.
# Same server-only value as game_private.signing_key.secret; at least 64 chars.
# GAME_SIGNING_KEY=
NARRATIVE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
# Captura de errores (Sentry). Vacío desactiva el envío.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Solo para comprobar la captura: GET /functions/v1/health?sentry-test=1 envía un evento de prueba.
SENTRY_TEST_EVENTS=false
